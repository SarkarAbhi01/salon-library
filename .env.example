DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salon_library_saas?schema=public"
# 32+ random characters (API refuses to start otherwise)
JWT_SECRET="change-this-to-a-long-random-secret-at-least-32-characters"
PORT=4000
# Comma-separated list of allowed browser origins
WEB_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# Frontend API URL. Keep this for local development.
VITE_API_URL="http://localhost:4000/api"
# "mock" = demo gateway (student "Pay" button succeeds instantly). Use a real gateway + webhook in production.
PAYMENT_PROVIDER="mock"

# ── Browser push notifications (optional) ──
# Generate once:  npx web-push generate-vapid-keys   then paste both keys here and restart the API.
# Leave empty to run without push — the "Notify me" buttons simply do not appear.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
